# Public site URL (used for canonical URLs, Open Graph, sitemap, and robots.txt)
# Set this to your deployed production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://vjpranastudio.com

# Contact Form Backend Integration (configure ONE of the options below)
# Option 1: Resend Email API (recommended for Vercel deployments)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="VJ PRANA Website <onboarding@resend.dev>"
CONTACT_TO_EMAIL=hello@vjpranastudio.com

# Option 2: Custom Webhook URL (e.g., Formspree, Make, Zapier, n8n, or CRM webhook)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional: YouTube Video Integration (add 11-character YouTube video IDs & channel URL)
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
NEXT_PUBLIC_YOUTUBE_FEATURED_ID=
NEXT_PUBLIC_YOUTUBE_VIDEO_2_ID=
NEXT_PUBLIC_YOUTUBE_VIDEO_3_ID=

# News & Events Ticker Admin Panel (/admin/news)
# Required in production (in local dev only, falls back to "vjprana2026" if unset)
NEWS_ADMIN_PASSWORD=
# Optional custom signing secret for admin session cookies
NEWS_ADMIN_SECRET=

# Optional persistent KV storage for Vercel/serverless deployments
# (Locally, news saves automatically to data/news.json without KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
